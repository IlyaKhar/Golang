# Многоэтапная сборка (multi-stage build)
# Этап 1: Сборка
FROM golang:1.21-alpine AS builder

# ТЕОРИЯ: Устанавливаем рабочую директорию
WORKDIR /app

# ТЕОРИЯ: Копируем go.mod и go.sum для кэширования зависимостей
# - Docker кэширует слои, если файлы не изменились
# - Это ускоряет сборку при изменении только кода
COPY go.mod go.sum ./
RUN go mod download

# ТЕОРИЯ: Копируем весь код и собираем
COPY . .
RUN go build -o server ./deploy

# Этап 2: Запуск (минимальный образ)
FROM alpine:latest

# ТЕОРИЯ: Устанавливаем CA сертификаты для HTTPS запросов
RUN apk --no-cache add ca-certificates

WORKDIR /root/

# ТЕОРИЯ: Копируем только скомпилированный бинарник
# - Не копируем исходный код (он не нужен для запуска)
# - Это уменьшает размер финального образа
COPY --from=builder /app/server .

# ТЕОРИЯ: Открываем порт (информация для документации)
EXPOSE 8080

# ТЕОРИЯ: Команда запуска
CMD ["./server"]

